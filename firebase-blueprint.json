{
  "entities": {
    "Site": {
      "title": "Site",
      "description": "An indexed website or link in SNNS.PRO database",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the site"
        },
        "url": {
          "type": "string",
          "description": "Full URL of the website"
        },
        "title": {
          "type": "string",
          "description": "Title of the website",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "description": "Short summary or description of the website",
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "description": "Category such as tech, news, tools, education, media, general",
          "maxLength": 50
        },
        "tags": {
          "type": "string",
          "description": "Comma separated keywords or tags for search indexing",
          "maxLength": 300
        },
        "favicon": {
          "type": "string",
          "description": "URL to website favicon or icon",
          "maxLength": 500
        },
        "clicks": {
          "type": "number",
          "description": "Number of times this result was clicked"
        },
        "isVerified": {
          "type": "boolean",
          "description": "Whether the website has been verified"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of indexing"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "url", "title", "description", "category", "createdAt"]
    },
    "SearchQuery": {
      "title": "SearchQuery",
      "description": "Popular or recent search query logged in the engine",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique query ID"
        },
        "query": {
          "type": "string",
          "description": "The search term",
          "maxLength": 150
        },
        "count": {
          "type": "number",
          "description": "Number of times this query was executed"
        },
        "lastSearchedAt": {
          "type": "string",
          "description": "Timestamp of the last search"
        }
      },
      "required": ["id", "query", "count"]
    },
    "UserProfileDoc": {
      "title": "UserProfileDoc",
      "description": "Registered SNNS user profile and live presence",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User ID / Firebase UID" },
        "name": { "type": "string", "description": "Full display name" },
        "email": { "type": "string", "description": "Verified SNNS email" },
        "snnsHandle": { "type": "string", "description": "SNNS username prefix" },
        "roleAr": { "type": "string", "description": "Arabic role title" },
        "departmentAr": { "type": "string", "description": "Arabic department name" },
        "avatarInitials": { "type": "string", "description": "Initials for avatar" },
        "avatarColor": { "type": "string", "description": "Tailwind color class for avatar" },
        "isOnline": { "type": "boolean", "description": "Whether user is currently connected" },
        "lastActive": { "type": "string", "description": "ISO timestamp of last activity heartbeat" },
        "allowDiscovery": { "type": "boolean", "description": "Whether user allows discovery in Connect directory" }
      },
      "required": ["id", "name", "email", "lastActive"]
    },
    "ContactRelation": {
      "title": "ContactRelation",
      "description": "User contact relationship status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Target user ID" },
        "targetUserId": { "type": "string", "description": "Target user ID" },
        "targetName": { "type": "string", "description": "Target display name" },
        "targetEmail": { "type": "string", "description": "Target email" },
        "status": { "type": "string", "description": "Relationship status (pending_sent, pending_received, accepted, blocked)" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of relation update" }
      },
      "required": ["id", "targetUserId", "targetName", "targetEmail", "status", "updatedAt"]
    },
    "ConversationDoc": {
      "title": "ConversationDoc",
      "description": "1-on-1 private conversation thread",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Deterministic conversation ID (uid1_uid2)" },
        "participantIds": { "type": "array", "description": "Array of participant user IDs", "items": { "type": "string" } },
        "lastMessage": { "type": "string", "description": "Latest message text snippet" },
        "lastMessageAt": { "type": "string", "description": "ISO timestamp of latest message" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of update" }
      },
      "required": ["id", "participantIds", "updatedAt"]
    },
    "ChatMessageDoc": {
      "title": "ChatMessageDoc",
      "description": "Direct chat message in a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message ID" },
        "conversationId": { "type": "string", "description": "Parent conversation ID" },
        "senderId": { "type": "string", "description": "Sender user ID" },
        "senderName": { "type": "string", "description": "Sender display name" },
        "text": { "type": "string", "description": "Message content" },
        "timestamp": { "type": "string", "description": "ISO timestamp of message" },
        "status": { "type": "string", "description": "Delivery status: sent, delivered, read" }
      },
      "required": ["id", "conversationId", "senderId", "senderName", "text", "timestamp"]
    }
  },
  "firestore": {
    "/sites/{siteId}": {
      "schema": "Site",
      "description": "Collection of all indexed websites and links"
    },
    "/queries/{queryId}": {
      "schema": "SearchQuery",
      "description": "Trending and autocomplete search query logs"
    },
    "/users/{userId}": {
      "schema": "UserProfileDoc",
      "description": "Registered SNNS user profile and live presence"
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": "ContactRelation",
      "description": "User contact list and relationship states"
    },
    "/conversations/{conversationId}": {
      "schema": "ConversationDoc",
      "description": "1-on-1 private conversation threads"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ChatMessageDoc",
      "description": "Direct chat messages within a conversation"
    }
  }
}
